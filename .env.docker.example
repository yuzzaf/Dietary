# ---------------------------------------------------------------------------
# Root .env consumed by docker compose (docker compose reads ./.env).
# Copy to ".env" and fill in - do NOT commit the filled-in file.
#   cp .env.docker.example .env
# ---------------------------------------------------------------------------

# --- Database (internal to the compose network) ----------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=Dietary

# --- Public API Port & CORS ------------------------------------------------
PORT=3000
# Origin allowed to call the API (Vercel domain or localhost)
CORS_ORIGIN=https://app.muhammadyuzzaf.com

# --- Server runtime secrets (same keys as server/.env) ---------------------
JWT_SECRET=change_me_super_secret_jwt_key
GEMINI_API_KEY=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
EMAIL_USER=
EMAIL_PASS=

# --- Behaviour toggles -----------------------------------------------------
# false = the entrypoint skips "sequelize-cli db:migrate"
RUN_MIGRATIONS=true
